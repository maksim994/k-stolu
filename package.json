{
  "name": "k-stolu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "setup": "node scripts/setup.mjs",
    "setup:production": "node scripts/setup-production.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "admin:password": "node scripts/password.mjs",
    "format": "prettier --write src scripts next.config.ts tsconfig.json vitest.config.ts",
    "format:check": "prettier --check src scripts next.config.ts tsconfig.json vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.10",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
